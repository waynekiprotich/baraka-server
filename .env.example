# Copy to .env and fill in. Never commit the real file.

# development | testing | production
FLASK_ENV=development
FLASK_APP=wsgi.py

# Signing secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to boot in production while these are unset.
SECRET_KEY=
JWT_SECRET_KEY=

# PostgreSQL over TCP. Defaults to postgresql+psycopg://<unix user>@localhost:5432/baraka
DATABASE_URL=postgresql+psycopg://youruser@localhost:5432/baraka
TEST_DATABASE_URL=postgresql+psycopg://youruser@localhost:5432/baraka_test

# Token lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
CORS_MAX_AGE=600

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=8388608

# Number of reverse proxies actually in front of the app. 0 locally.
# Setting this higher than the real hop count lets a caller forge their IP
# through X-Forwarded-For and evade rate limiting.
TRUSTED_PROXY_HOPS=0

# Salt for the one-way hash stored against an enquiry instead of the raw IP.
IP_HASH_SALT=

# Supabase Postgres (session pooler, port 5432). Get this from
# Supabase dashboard -> Settings -> Database -> Connection string -> "Session pooler".
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage, used for admin image uploads (server-side only -- the
# service-role key must never reach the frontend). From Settings -> API.
# When unset, uploads fall back to local disk automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=images

# ImageKit, used for admin image uploads (server-side only -- the private key
# must never reach the frontend). Get these from the ImageKit dashboard ->
# Developer options -> API keys. When unset, falls back to Supabase Storage,
# then local disk.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
